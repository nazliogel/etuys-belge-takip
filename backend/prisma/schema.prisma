generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  COMPANY
}

enum ImportBatchStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportType {
  OPEN
  CLOSED
  COMPANY_IDENTITY
  DOCUMENT_DETAIL
}

enum ImportRowStatus {
  PENDING
  NEW
  CHANGED
  UNCHANGED
  INVALID
  CONFLICT
}

enum ImportChangeStatus {
  PENDING
  APPLIED
}

enum ChangeType {
  CREATED
  UPDATED
  DEACTIVATED
  REACTIVATED
}

enum EntityType {
  COMPANY
  COMPANY_AUTHORIZATION
  INCENTIVE_DOCUMENT
  CLOSED_INCENTIVE_DOCUMENT
}

enum ChangeSource {
  EXCEL_IMPORT
  MANUAL_UPDATE
  SYSTEM
}

enum DocumentStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum NotificationType {
  AUTHORIZATION_EXPIRING
  AUTHORIZATION_EXPIRED
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  EXTENSION_EXPIRING
  IMPORT_COMPLETED
  SYSTEM
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  uploadedImports ImportBatch[]   @relation("ImportUploadedBy")
  changeHistory   ChangeHistory[]
  notifications   Notification[]
  companyNotes    CompanyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Company {
  id                Int     @id @default(autoincrement())
  externalCompanyId Int     @unique
  name              String
  taxNumber         String
  processStatus     String?
  consultant        String?
  isActive          Boolean @default(true)

  users           User[]
  authorization   CompanyAuthorization?
  identity        CompanyIdentity?
  documents       IncentiveDocument[]
  importRows      ImportRow[]
  closedDocuments ClosedIncentiveDocument[]
  importChanges   ImportChange[]
  changeHistory   ChangeHistory[]
  notifications   Notification[]
  contacts        CompanyContact[]
  notes           CompanyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxNumber])
  @@index([name])
}

model CompanyIdentity {
  id        Int @id @default(autoincrement())
  companyId Int @unique

  investorStatus      String?
  mersisNumber        String?
  investorType        String?
  investorAddress     String?
  registrationDate    DateTime? @db.Date
  tradeRegistryNumber String?
  nationalId          String?
  city                String?
  district            String?
  mainActivity        String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CompanyContact {
  id        Int    @id @default(autoincrement())
  companyId Int
  fullName  String
  email     String
  phone     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CompanyNote {
  id        Int    @id @default(autoincrement())
  companyId Int
  text      String
  authorId  Int?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([authorId])
}

model CompanyAuthorization {
  id                   Int       @id @default(autoincrement())
  companyId            Int       @unique
  authorizationEndDate DateTime? @db.Date

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncentiveDocument {
  id                 Int            @id @default(autoincrement())
  companyId          Int
  externalDocumentId Int            @unique
  documentNumber     String?
  documentStartDate  DateTime?      @db.Date
  documentEndDate    DateTime?      @db.Date
  extensionDate      DateTime?      @db.Date
  supportClass       String?
  status             DocumentStatus @default(OPEN)
  isActive           Boolean        @default(true)

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importRows    ImportRow[]
  importChanges ImportChange[]
  changeHistory ChangeHistory[]
  detail        DocumentDetail?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([documentNumber])
}

model ClosedIncentiveDocument {
  id                 Int            @id @default(autoincrement())
  companyId          Int
  externalDocumentId Int            @unique
  documentNumber     String?
  documentStartDate  DateTime?      @db.Date
  documentEndDate    DateTime?      @db.Date
  extensionDate      DateTime?      @db.Date
  supportClass       String?
  status             DocumentStatus

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([documentNumber])
}

model ImportBatch {
  id                Int               @id @default(autoincrement())
  fileName          String
  storedFileName    String?
  status            ImportBatchStatus @default(UPLOADED)
  importType        ImportType        @default(OPEN)
  isFullSnapshot    Boolean           @default(true)
  totalRowCount     Int               @default(0)
  validRowCount     Int               @default(0)
  invalidRowCount   Int               @default(0)
  newRowCount       Int               @default(0)
  changedRowCount   Int               @default(0)
  unchangedRowCount Int               @default(0)
  uploadedById      Int

  uploadedBy    User            @relation("ImportUploadedBy", fields: [uploadedById], references: [id])
  rows          ImportRow[]
  changes       ImportChange[]
  changeHistory ChangeHistory[]
  notifications Notification[]

  uploadedAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([uploadedById])
}

model ImportRow {
  id                   Int             @id @default(autoincrement())
  importBatchId        Int
  sheetName            String          @default("MAIN")
  rowNumber            Int
  status               ImportRowStatus
  externalCompanyId    Int?
  companyName          String?
  taxNumber            String?
  authorizationEndDate DateTime?       @db.Date
  externalDocumentId   Int?
  documentNumber       String?
  documentStartDate    DateTime?       @db.Date
  documentEndDate      DateTime?       @db.Date
  extensionDate        DateTime?       @db.Date
  supportClass         String?
  documentStatus       DocumentStatus?
  processStatus        String?
  companyId            Int?
  documentId           Int?
  rawData              Json?
  errorMessage         String?

  importBatch ImportBatch        @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  company     Company?           @relation(fields: [companyId], references: [id])
  document    IncentiveDocument? @relation(fields: [documentId], references: [id])
  changes     ImportChange[]

  createdAt DateTime @default(now())

  @@unique([importBatchId, sheetName, rowNumber])
  @@index([importBatchId, status])
  @@index([externalCompanyId])
  @@index([externalDocumentId])
}

model ImportChange {
  id            Int                @id @default(autoincrement())
  importBatchId Int
  importRowId   Int?
  companyId     Int?
  documentId    Int?
  entityType    EntityType
  changeType    ChangeType
  fieldName     String
  oldValue      String?
  newValue      String?
  status        ImportChangeStatus @default(PENDING)

  importBatch ImportBatch        @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importRow   ImportRow?         @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  company     Company?           @relation(fields: [companyId], references: [id])
  document    IncentiveDocument? @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())

  @@index([importBatchId, status])
  @@index([companyId])
  @@index([documentId])
}

model ChangeHistory {
  id            Int          @id @default(autoincrement())
  entityType    EntityType
  entityId      Int
  fieldName     String
  oldValue      String?
  newValue      String?
  source        ChangeSource
  companyId     Int?
  documentId    Int?
  importBatchId Int?
  changedById   Int?

  company     Company?           @relation(fields: [companyId], references: [id])
  document    IncentiveDocument? @relation(fields: [documentId], references: [id])
  importBatch ImportBatch?       @relation(fields: [importBatchId], references: [id])
  changedBy   User?              @relation(fields: [changedById], references: [id])

  changedAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([documentId])
  @@index([importBatchId])
}

model Notification {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  type        NotificationType
  isRead      Boolean          @default(false)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([companyId])
  @@index([importBatchId])
  @@index([type])
  @@index([createdAt])
}

model SystemSetting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       Json
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentDetail {
  id         Int @id @default(autoincrement())
  documentId Int @unique

  investmentType String?

  document IncentiveDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  products          DocumentProduct[]
  supports          DocumentSupport[]
  financialInfo     DocumentFinancialInfo?
  domesticMachines  DocumentDomesticMachine[]
  importedMachines  DocumentImportedMachine[]
  specialConditions DocumentSpecialCondition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
}

model DocumentProduct {
  id       Int @id @default(autoincrement())
  detailId Int

  productName     String?
  us97Code        String?
  us97Description String?
  naceCode        String?
  naceDescription String?
  unit            String?

  existingCapacity   Decimal?
  additionalCapacity Decimal?
  totalCapacity      Decimal?

  detail DocumentDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([detailId])
}

model DocumentSupport {
  id       Int @id @default(autoincrement())
  detailId Int

  supportType        String?
  supportTypeCode    String?
  supportRate        String?
  supportRateCode    String?
  supportDescription String?

  detail DocumentDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([detailId])
}

model DocumentFinancialInfo {
  id       Int @id @default(autoincrement())
  detailId Int @unique

  // Finansal Bilgiler ID
  externalFinancialInfoId String?

  // Genel finansman
  totalInvestment      Decimal?
  totalFinancing       Decimal?
  equity               Decimal?
  equityRate           Decimal?
  foreignResources     Decimal?
  foreignResourcesRate Decimal?

  // Krediler
  tlLoan                     Decimal?
  foreignCurrencyLoan        Decimal?
  foreignCurrencyIndexedLoan Decimal?
  domesticLoan               Decimal?
  foreignLoan                Decimal?
  otherLoans                 Decimal?
  financialLeasing           Decimal?

  // Makine / teçhizat
  domesticMachinery      Decimal?
  importedMachinery      Decimal?
  totalMachineryExpenses Decimal?
  newMachinery           Decimal?
  usedMachinery          Decimal?
  importedMachineryUsd   Decimal?

  // Bina / inşaat
  totalBuildingConstructionExpenses Decimal?
  mainBuilding                      Decimal?
  auxiliaryEnterpriseEquipment      Decimal?
  auxiliaryFacilities               Decimal?

  // Diğer yatırım harcamaları
  otherInvestmentExpenses Decimal?
  landCost                Decimal?
  landArrangement         Decimal?
  importCustoms           Decimal?
  transportInsurance      Decimal?
  assembly                Decimal?
  studyProject            Decimal?
  otherExpenses           Decimal?
  generalExpenses         Decimal?

  // Sabit yatırım değerleri
  fixedInvestmentUsd          Decimal?
  fixedInvestmentCpi          Decimal?
  fixedInvestmentUsdFirstCopy Decimal?
  fixedInvestmentCpiFirstCopy Decimal?

  rawData Json?

  detail DocumentDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([detailId])
}

model DocumentDomesticMachine {
  id       Int @id @default(autoincrement())
  detailId Int

  // Temel bilgiler
  externalMachineId Int?
  sequenceNumber    Int?

  name        String?
  quantity    Decimal?
  unitPriceTl Decimal?
  totalTl     Decimal?
  unit        String?

  // KDV
  vatExemption            String?
  vatExemptionDescription String?

  // Devir
  transferRealizedValue    Decimal?
  transferRealizedQuantity Decimal?
  transferOutgoingValue    Decimal?
  transferOutgoingQuantity Decimal?

  // Kiralama
  leasingOutgoingValue     Decimal?
  leasingOutgoingQuantity  Decimal?
  leasingPermittedValue    Decimal?
  leasingPermittedQuantity Decimal?

  // Fatura gerçekleşen
  invoiceRealizedValue    Decimal?
  invoiceRealizedQuantity Decimal?

  // Gümrük
  customsRealizedValue     Decimal?
  customsRealizedQuantity  Decimal?
  customsPermittedValue    Decimal?
  customsPermittedQuantity Decimal?

  // İhraç
  exportOutgoingValue     Decimal?
  exportOutgoingQuantity  Decimal?
  exportPermittedValue    Decimal?
  exportPermittedQuantity Decimal?

  // Finansal kiralama
  financialLeasingRealizedValue     Decimal?
  financialLeasingRealizedQuantity  Decimal?
  financialLeasingPermittedValue    Decimal?
  financialLeasingPermittedQuantity Decimal?

  // Satış
  saleOutgoingValue     Decimal?
  saleOutgoingQuantity  Decimal?
  salePermittedValue    Decimal?
  salePermittedQuantity Decimal?
  saleRealizedQuantity  Decimal?
  saleRealizedValue     Decimal?

  // GTIP
  gtipCode        String?
  gtipDescription String?

  // Devir gelen
  transferDocumentNumber   String?
  transferIncomingQuantity Decimal?
  transferIncomingAmount   Decimal?

  // Diğer bilgiler
  barcode                 String?
  sellerTaxNumber         String?
  sellerEmail             String?
  financialLeasingCompany String?
  machineryEquipmentType  String?

  rawData Json?

  detail DocumentDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([detailId])
  @@index([externalMachineId])
}

model DocumentImportedMachine {
  id       Int @id @default(autoincrement())
  detailId Int

  externalMachineId Int?
  sequenceNumber    Int?

  name     String?
  quantity Decimal?
  unit     String?

  gtipCode        String?
  gtipDescription String?

  currency    String?
  fobAmount   Decimal?
  fobAmountTl Decimal?
  cifAmountTl Decimal?

  usedMachine String?

  rawData Json?

  detail DocumentDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([detailId])
  @@index([externalMachineId])
}

model DocumentSpecialCondition {
  id       Int @id @default(autoincrement())
  detailId Int

  conditionCode String?
  conditionName String?
  description   String? @db.Text

  detail DocumentDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([detailId])
}
